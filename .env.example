# --- Database ---
POSTGRES_USER=aviationlog
POSTGRES_PASSWORD=please-change
POSTGRES_DB=aviationlog

# --- App ---
# Image tag from ghcr.io/siliconserver/aviationlog:
# latest = newest release, main = current main branch, or a fixed version like 0.1
AVIATIONLOG_TAG=latest
APP_PORT=8090

# Long random string for session cookies (e.g. `openssl rand -hex 32`)
SECRET_KEY=please-change-to-a-long-random-string

# First admin, created automatically on first start
ADMIN_USERNAME=admin
ADMIN_PASSWORD=please-change
ADMIN_EMAIL=

# Public URL of the app (used in password reset mails), e.g. https://aviationlog.example.com
BASE_URL=
# Default UI language for new users: en or de
DEFAULT_LANGUAGE=en
TZ=Europe/Berlin
# Set to true when the app is only reachable via HTTPS (e.g. behind Traefik)
SESSION_HTTPS_ONLY=false

# --- Photos ---
# upload = photos are uploaded through the web UI (root server)
# nas    = an existing photo archive is mounted read-only and scanned
PHOTO_MODE=upload
# Folder on the host. upload: leave as is. nas: path to your archive, e.g. /volume1/photos/spotting
PHOTO_HOST_DIR=./data/app/photos
# Folder inside the container (usually no need to change)
PHOTO_DIR=/data/photos
# nas: set to :ro so the archive is mounted read-only. upload: leave empty.
PHOTO_MOUNT_OPTS=

# --- SMTP (optional, for password reset mails) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
